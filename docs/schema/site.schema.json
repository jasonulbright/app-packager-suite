{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jasonulbright/app-packager-suite/docs/schema/site.schema.json",
  "title": "Site data: site.json",
  "description": "Identity and contract version of one site folder, sites\\<SITECODE>\\site.json.",
  "type": "object",
  "required": ["schemaVersion", "siteCode", "providers", "createdUtc", "lastUsedUtc"],
  "properties": {
    "schemaVersion": { "enum": [1] },
    "siteCode": { "type": "string", "pattern": "^[A-Z0-9]{3}$" },
    "label": { "type": "string" },
    "providers": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "createdUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "lastUsedUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "migratedFrom": { "enum": ["legacy-single-site"] }
  }
}
