      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "SiteCode",
      "scope": "site",
      "import": "never",
      "target": "settings.json",
      "note": "Identity of the site. The target has its own."
    },
    {
      "id": "apd.provider",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "ProviderMachine",
      "scope": "site",
      "import": "never",
      "target": "settings.json",
      "note": "SMS Provider FQDN. Also listed in site.json providers."
    },
    {
      "id": "apd.sql-server",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "DiscoverySqlServer",
      "scope": "site",
      "import": "never",
      "target": "settings.json"
    },
    {
      "id": "apd.sql-database",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "DiscoverySqlDatabase",
      "scope": "site",
      "import": "never",
      "target": "settings.json"
    },
