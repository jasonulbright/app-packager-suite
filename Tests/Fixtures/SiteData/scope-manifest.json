      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "ContentDistribution",
      "scope": "site",
      "import": "on",
      "target": "settings.json",
      "note": "DP group and test collection names only."
    },
    {
      "id": "apd.distribution-overrides",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "DistributionOverrides",
      "scope": "site",
      "import": "on",
      "target": "settings.json",
      "note": "Names only."
