    {
      "id": "apd.app-state-latest",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "AppStates.LatestVersion",
      "scope": "global",
      "import": "never",
      "target": null
    },
    {
      "id": "apd.one-click",
      "app": "apd",
      "kind": "setting",
