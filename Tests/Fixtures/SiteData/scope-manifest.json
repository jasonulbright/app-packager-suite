      "scope": "global",
      "import": "on",
      "target": null
    },
    {
      "id": "apd.hygiene-options",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "Site Hygiene options (areas, pause, thresholds, alerts)",
      "scope": "site",
      "import": "on",
      "target": "settings.json"
    },
    {
      "id": "apd.ui",
      "app": "apd",
      "kind": "setting",
      "location": "settings.json",
      "key": "Theme, window, sidebar, page filters",
      "scope": "global",
      "import": "never",
      "target": null,
      "note": "A page ignores an unknown folder in a filter."
    },
    {
